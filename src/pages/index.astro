---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import HomeEntry from "@/components/HomeEntry.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;

const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const heroImage = `${baseRoot}images/hero/main2.png`;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const getPostPath = (post: (typeof sortedPosts)[number]) =>
  (post.filePath ?? "").replaceAll("\\", "/");

const writeupPosts = sortedPosts
  .filter(post =>
    getPostPath(post).includes("src/content/posts/writeups/")
  )
  .slice(0, 2);

const researchPosts = sortedPosts
  .filter(post =>
    getPostPath(post).includes("src/content/posts/research/")
  )
  .slice(0, 2);

const pixelArtPosts = sortedPosts
  .filter(post =>
    getPostPath(post).includes("src/content/posts/pixel-art/")
  )
  .slice(0, 2);

const formatDate = (date: Date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}.${month}.${day}`;
};

const postHref = (id: string) => {
  const slug = id.replace(/\.(md|mdx)$/, "");
  return getRelativeLocaleUrl(locale, `posts/${slug}`);
};
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout space-y-4 pt-4 pb-8">

    <!-- HERO -->
    <section class="grid gap-4 lg:grid-cols-3 lg:items-stretch">

      <!-- LEFT PANEL -->
      <div
        class="border-border flex flex-col border p-6 sm:p-8 lg:min-h-[560px]"
      >
        <div
          class="text-muted-foreground mb-8 flex items-center justify-between text-sm"
        >
          <span>01</span>
          <span class="bg-accent h-2 w-2"></span>
        </div>

        <h1
          class="font-display text-6xl font-semibold tracking-tight lg:text-7xl"
        >
          GLouM
        </h1>

        <p class="mt-5 text-xl leading-snug">
          Notes, writeups, research,<br />
          and projects.
        </p>

        <div class="bg-accent mt-5 h-1 w-10"></div>

        <p class="text-muted-foreground mt-6 leading-7">
          Exploring systems, security, technical topics, and other things I
          learn along the way.
        </p>

        {
          socials.length > 0 && (
            <div class="mt-6 flex items-center gap-3">
              <span class="text-muted-foreground text-sm">Social</span>
              <Socials />
            </div>
          )
        }

        <div class="mt-auto grid grid-cols-2 gap-3 pt-8">

          <a
            href={getRelativeLocaleUrl(locale, "writeups")}
            class="border-border hover:border-accent block border p-4 transition"
          >
            <div class="text-accent text-sm">01</div>

            <div class="mt-2 flex items-center justify-between">
              <span>Writeups</span>
              <span>→</span>
            </div>
          </a>

          <a
            href={getRelativeLocaleUrl(locale, "research")}
            class="border-border hover:border-accent block border p-4 transition"
          >
            <div class="text-accent text-sm">02</div>

            <div class="mt-2 flex items-center justify-between">
              <span>Research</span>
              <span>→</span>
            </div>
          </a>

          <a
            href={getRelativeLocaleUrl(locale, "pixel-art")}
            class="border-border hover:border-accent block border p-4 transition"
          >
            <div class="text-accent text-sm">03</div>

            <div class="mt-2 flex items-center justify-between">
              <span>Pixel Art</span>
              <span>→</span>
            </div>
          </a>

          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class="border-border hover:border-accent block border p-4 transition"
          >
            <div class="text-accent text-sm">04</div>

            <div class="mt-2 flex items-center justify-between">
              <span>About</span>
              <span>→</span>
            </div>
          </a>

        </div>
      </div>

      <!-- PIXEL SCENE -->
      <div
        class="border-border relative min-h-[420px] overflow-hidden border lg:col-span-2 lg:min-h-[560px]"
      >
        <img
          src={heroImage}
          alt="Pixel art night scene"
          class="absolute inset-0 h-full w-full object-contain lg:object-cover"
          style="image-rendering: pixelated; object-position: center 58%;"
        />
      </div>

    </section>

    <!-- LOWER SECTIONS -->
    <section class="grid gap-4 lg:grid-cols-3">

      <!-- WRITEUPS -->
      <article class="border-border bg-background/20 border">

        <div class="p-5">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-muted-foreground text-sm">02</span>

            <a
              href={getRelativeLocaleUrl(locale, "writeups")}
              class="text-accent text-sm"
            >
              View all →
            </a>
          </div>

          <h2 class="font-display text-3xl font-semibold">
            Recent Writeups
          </h2>
        </div>

        <div>
          {
            writeupPosts.length > 0 ? (
              writeupPosts.map(post => (
                <HomeEntry
                  title={post.data.title}
                  description={post.data.description}
                  date={formatDate(post.data.pubDatetime)}
                  type="WRITEUP"
                  tags={post.data.tags}
                  href={postHref(post.id)}
                  image={post.data.image}
                />
              ))
            ) : (
              <p class="border-border text-muted-foreground border-t p-5 text-sm">
                No writeups yet.
              </p>
            )
          }
        </div>

      </article>

      <!-- RESEARCH -->
      <article class="border-border bg-background/20 border">

        <div class="p-5">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-muted-foreground text-sm">03</span>

            <a
              href={getRelativeLocaleUrl(locale, "research")}
              class="text-accent text-sm"
            >
              View all →
            </a>
          </div>

          <h2 class="font-display text-3xl font-semibold">
            Research Notes
          </h2>
        </div>

        <div>
          {
            researchPosts.length > 0 ? (
              researchPosts.map(post => (
                <HomeEntry
                  title={post.data.title}
                  description={post.data.description}
                  date={formatDate(post.data.pubDatetime)}
                  type="RESEARCH"
                  tags={post.data.tags}
                  href={postHref(post.id)}
                  image={post.data.image}
                />
              ))
            ) : (
              <p class="border-border text-muted-foreground border-t p-5 text-sm">
                No research posts yet.
              </p>
            )
          }
        </div>

      </article>

      <!-- PIXEL ART -->
      <article class="border-border bg-background/20 border">

        <div class="p-5">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-muted-foreground text-sm">04</span>

            <a
              href={getRelativeLocaleUrl(locale, "pixel-art")}
              class="text-accent text-sm"
            >
              View all →
            </a>
          </div>

          <h2 class="font-display text-3xl font-semibold">
            Pixel Art
          </h2>
        </div>

        <div>
          {
            pixelArtPosts.length > 0 ? (
              pixelArtPosts.map(post => (
                <HomeEntry
                  title={post.data.title}
                  description={post.data.description}
                  date={formatDate(post.data.pubDatetime)}
                  type="PIXEL ART"
                  tags={post.data.tags}
                  href={postHref(post.id)}
                  image={post.data.image}
                />
              ))
            ) : (
              <p class="border-border text-muted-foreground border-t p-5 text-sm">
                No pixel art posts yet.
              </p>
            )
          }
        </div>

      </article>

    </section>

  </main>

  <Footer />
</Layout>