---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";

import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import HomeEntry from "@/components/HomeEntry.astro";

import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);

const getPostPath = (post: (typeof sortedPosts)[number]) =>
  (post.filePath ?? "").replaceAll("\\", "/");

/*
 * Get only posts inside:
 * src/content/posts/writeups/
 */
const writeupPosts = sortedPosts.filter(post =>
  getPostPath(post).includes("src/content/posts/writeups/")
);

/*
 * Convert folder names into nicer labels.
 */
const categoryLabels: Record<string, string> = {
  hackthebox: "Hack The Box",
  tryhackme: "TryHackMe",
  labs: "Labs",
};

/*
 * Example:
 *
 * src/content/posts/writeups/hackthebox/test-writeup.md
 *                                ↓
 *                           "hackthebox"
 */
const getCategory = (post: (typeof sortedPosts)[number]) => {
  const path = getPostPath(post);

  const marker = "src/content/posts/writeups/";
  const relative = path.split(marker)[1] ?? "";

  return relative.split("/")[0] || "other";
};

const getCategoryLabel = (category: string) => {
  if (categoryLabels[category]) {
    return categoryLabels[category];
  }

  return category
    .split("-")
    .map(word => word.charAt(0).toUpperCase() + word.slice(1))
    .join(" ");
};

/*
 * Group posts by their first folder below /writeups.
 */
const groupedPosts = writeupPosts.reduce(
  (groups, post) => {
    const category = getCategory(post);

    if (!groups[category]) {
      groups[category] = [];
    }

    groups[category].push(post);

    return groups;
  },
  {} as Record<string, typeof writeupPosts>
);

const categories = Object.entries(groupedPosts);

const formatDate = (date: Date) => {
  const year = date.getFullYear();
  const month = String(date.getMonth() + 1).padStart(2, "0");
  const day = String(date.getDate()).padStart(2, "0");

  return `${year}.${month}.${day}`;
};

const postHref = (id: string) => {
  const slug = id.replace(/\.(md|mdx)$/, "");

  return getRelativeLocaleUrl(locale, `posts/${slug}`);
};
---

<Layout>
  <Header />

  <main id="main-content" class="app-layout pt-12 pb-8">

    <!-- PAGE HEADER -->
    <section class="border-border border">

      <div class="border-border border-b p-6 sm:p-8">

        <div class="text-muted-foreground mb-3 text-sm">
          02 / WRITEUPS
        </div>

        <h1 class="font-display text-5xl font-semibold">
          Writeups
        </h1>

        <p class="text-muted-foreground mt-4 max-w-2xl leading-7">
          Technical writeups from labs, challenges, and other environments.
        </p>

      </div>

      {
        categories.length > 0 ? (
          <div>
            {categories.map(([category, posts]) => (
              <section class="border-border border-b last:border-b-0">

                <!-- CATEGORY HEADER -->
                <div class="border-border flex items-center justify-between border-b px-6 py-5 sm:px-8">

                  <div>
                    <div class="text-accent mb-1 text-xs">
                      CATEGORY
                    </div>

                    <h2 class="font-display text-3xl font-semibold">
                      {getCategoryLabel(category)}
                    </h2>
                  </div>

                  <div class="text-muted-foreground text-sm">
                    {posts.length} {posts.length === 1 ? "post" : "posts"}
                  </div>

                </div>

                <!-- POSTS -->
                <div>
                  {posts.map(post => (
                    <HomeEntry
                      title={post.data.title}
                      description={post.data.description}
                      date={formatDate(post.data.pubDatetime)}
                      type="WRITEUP"
                      tags={post.data.tags}
                      href={postHref(post.id)}
                      image={post.data.image}
                    />
                  ))}
                </div>

              </section>
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground p-6 sm:p-8">
            No writeups yet.
          </p>
        )
      }

    </section>

  </main>

  <Footer />
</Layout>