---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";

import Socials from "./Socials.astro";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border flex flex-col gap-6 border-t py-6 sm:flex-row sm:items-end sm:justify-between"
  >
    <!-- LEFT -->
    <div>
      <a
        href={getRelativeLocaleUrl(locale, "")}
        class="font-display inline-flex items-center text-xl font-semibold"
      >
        GLouM
        <span
          aria-hidden="true"
          class="bg-accent ms-1.5 inline-block size-2"
        ></span>
      </a>

      <div class="text-muted-foreground mt-2 text-xs">
        © {currentYear} GLouM
      </div>
    </div>

    <!-- RIGHT -->
    <div class="flex flex-col gap-3 sm:items-end">
      <nav
        aria-label="Footer navigation"
        class="text-muted-foreground flex flex-wrap gap-x-5 gap-y-2 text-sm"
      >
        <a
          href={getRelativeLocaleUrl(locale, "writeups")}
          class="hover:text-foreground transition"
        >
          Writeups
        </a>

        <a
          href={getRelativeLocaleUrl(locale, "research")}
          class="hover:text-foreground transition"
        >
          Research
        </a>

        <a
          href={getRelativeLocaleUrl(locale, "pixel-art")}
          class="hover:text-foreground transition"
        >
          Pixel Art
        </a>

        <a
          href={getRelativeLocaleUrl(locale, "about")}
          class="hover:text-foreground transition"
        >
          About
        </a>
      </nav>

      <Socials />
    </div>
  </div>
</footer>